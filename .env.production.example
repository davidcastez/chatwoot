# ============================================================================
# QualiChat Production Environment Variables
# ============================================================================
# Copy this to .env and fill in the values before deploying.
# ============================================================================

# Core
SECRET_KEY_BASE=GENERATE_WITH_RAKE_SECRET
FRONTEND_URL=https://chat.qualichat.app
RAILS_ENV=production
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false
DEFAULT_LOCALE=es

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/qualichat_production
RAILS_MAX_THREADS=5

# Redis (Railway Redis)
REDIS_URL=redis://default:password@host:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD

# Email (SendGrid recommended)
MAILER_SENDER_EMAIL=QualiChat <noreply@qualichat.app>
SMTP_DOMAIN=qualichat.app
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=YOUR_SENDGRID_API_KEY
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Storage (S3 or local)
ACTIVE_STORAGE_SERVICE=local
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# WhatsApp Business API (configured in Chatwoot admin UI per inbox)
# These are for the embedded signup flow:
# WHATSAPP_APP_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CONFIGURATION_ID=

# Facebook/Instagram
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=
# IG_VERIFY_TOKEN=

# Logging
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Disable Chatwoot push relay (not needed for self-hosted)
ENABLE_PUSH_RELAY_SERVER=false

# Mobile app identifiers (use defaults or customize)
# IOS_APP_ID=L7YLMN4634.com.chatwoot.app
# ANDROID_BUNDLE_ID=com.chatwoot.app
